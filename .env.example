# Copy to .env and replace every CHANGE_ME value with a unique secret.
HUB_USERNAME=admin
HUB_PASSWORD=CHANGE_ME_USE_A_LONG_UNIQUE_PASSWORD
HUB_SECRET=CHANGE_ME_64_RANDOM_CHARACTERS
HUB_WEBHOOK_SECRET=CHANGE_ME_A_DIFFERENT_WEBHOOK_SECRET
HUB_API_KEY=CHANGE_ME_A_DIFFERENT_ADMIN_API_KEY
HUB_SCOPE_WEBHOOK=1
HUB_CORS_ORIGINS=http://YOUR_VPS_HOSTNAME
HUB_AUTO_ENGINE=1
# V2 can only observe closed paper-engine bars. Keep off until observations
# are reviewed; 'shadow' records evidence but cannot execute trades.
HUB_CORE_V2_MODE=off
HUB_USE_LIVE_DATA=0
HUB_EXCHANGE=kraken
HUB_MAX_DAILY_LOSS=0.03
HUB_MAX_DRAWDOWN=0.20
HUB_EXPOSURE_LIMIT=0.05
HUB_STARTING_CASH=10000
